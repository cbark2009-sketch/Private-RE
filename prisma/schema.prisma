generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One row per case appearing on a specific auction date in a specific
// county. The same case can appear more than once over time if a sale gets
// rescheduled, so the unique key is (countySlug, caseNumber, auctionDate),
// not caseNumber alone - and countySlug is included because RealForeclose is
// a shared platform across many counties (see src/lib/counties.ts), so case
// number formats aren't even guaranteed unique across counties on their own.
//
// Note: we deliberately do NOT store data scraped from any county's Property
// Appraiser site - Orange's (ocpaweb.ocpafl.org) runs an active anti-bot
// firewall that explicitly blocks automated access, and we treat that as the
// default assumption for other counties' appraiser sites too rather than
// verify each one - `parcelUrl` is a link out for a human to check manually.
model Listing {
  id                   String   @id @default(cuid())
  countySlug           String
  auctionDate          DateTime
  caseNumber           String
  caseDetailUrl        String?
  finalJudgmentAmount  Float?
  estimatedMaxBid      Float?
  propertyAddress      String?
  zipCode              String?
  assessedValueAtSale  Float?
  parcelId             String?
  parcelUrl            String?
  scrapedAt            DateTime @default(now())

  @@unique([countySlug, caseNumber, auctionDate])
  @@index([countySlug, auctionDate])
  @@index([zipCode])
}

// Cached month-calendar day counts (src/lib/scrapeCalendar.ts), one row per
// (county, year, month). Short-lived cache (a few hours) since the "active"
// count for TODAY specifically decreases throughout the day as auctions
// resolve - unlike Listing/ValueEstimateCache this can't be cached for days.
model CalendarCache {
  countySlug String
  year       Int
  month      Int
  data       String // JSON-serialized DayCount[]
  fetchedAt  DateTime @default(now())

  @@id([countySlug, year, month])
}

// Cached building-permit lookups, keyed by (countySlug, parcelId) since each
// jurisdiction's permit system is queried by parcel/folio number, not
// address (see src/lib/permits/). Only a handful of counties have a known
// public, non-CAPTCHA permit data source (src/lib/permits/index.ts's
// registry) - most FL counties simply have no row here, ever, which is
// expected coverage, not a bug. 24h TTL, same as Listing rows - permits
// don't change fast, but these are free/unlimited government APIs (unlike
// RentCast) so there's no quota reason to cache longer.
model PermitCache {
  countySlug String
  parcelId   String
  data       String // JSON-serialized Permit[]
  fetchedAt  DateTime @default(now())

  @@id([countySlug, parcelId])
}

// A real account, replacing the old single-shared-password Basic Auth (see
// src/proxy.ts). Provisioned by Claude on request (src/scripts/add-user.mjs),
// not self-serve signup - built for a handful of people the owner knows
// personally, not the public. isBlocked is checked fresh on every request
// (src/proxy.ts), not baked into the session token, so blocking someone
// takes effect immediately rather than only on their next login.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  passwordSalt String
  isOwner      Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// Cached RentCast /avm/value results, keyed by property address. The free
// tier is 50 calls/month, so this cache is long-lived (30 days) - property
// values don't move fast enough to justify spending calls re-checking often.
model ValueEstimateCache {
  address             String   @id
  price               Float?
  priceRangeLow       Float?
  priceRangeHigh      Float?
  squareFootage       Float?
  compAvgPricePerSqft Float?
  compCount           Int?
  failed              Boolean  @default(false)
  fetchedAt           DateTime @default(now())
}
