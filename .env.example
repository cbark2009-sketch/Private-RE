# Local dev: leave DATABASE_URL as-is, leave the TURSO_* vars unset.
DATABASE_URL="file:./dev.db"

# Required. RentCast API key (free tier: 50 calls/month). Get one at
# https://app.rentcast.io
RENTCAST_API_KEY=""

# Production only (set these in Vercel's dashboard, not here). When
# TURSO_DATABASE_URL is set, src/lib/db.ts connects to Turso instead of the
# local SQLite file - see Turso's dashboard for these two values after
# creating a database there.
# TURSO_DATABASE_URL="libsql://<your-db>-<your-org>.turso.io"
# TURSO_AUTH_TOKEN=""

# Required in production. Signs session cookies for real per-user login
# (src/lib/auth.ts, src/proxy.ts) - generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset locally if you don't need to test login on your machine.
# SESSION_SECRET=""
